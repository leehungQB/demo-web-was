PORT=5000
DB_HOST=prv-1a-db01.cfo4k2mmsphe.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# AWS RDS yêu cầu SSL (bắt buộc để tránh lỗi: "no pg_hba.conf entry ... no encryption")
DB_SSL=true

# (Tùy chọn) Đường dẫn đến file chứng chỉ CA của RDS nếu muốn verify-full
# Tải về: wget https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_CA_CERT_PATH=./key-rds/global-bundle.pem
DB_SSL_REJECT_UNAUTHORIZED=false

# =========================================================
# Cấu hình Amazon S3 & VPC Endpoint (Lab S3 VPC Endpoint)
# =========================================================
# Tên S3 Bucket cần kết nối
S3_BUCKET=
# Region của S3 Bucket & VPC Endpoint
AWS_REGION=ap-southeast-1

# (Tùy chọn) Custom Endpoint URL khi dùng S3 Interface VPC Endpoint (AWS PrivateLink) mà tắt Private DNS
# Ví dụ: https://bucket.vpce-0123456789abcdef0-abcdefgh.s3.ap-southeast-1.vpce.amazonaws.com
# Để trống nếu dùng S3 Gateway VPC Endpoint (Route Table Prefix List) hoặc Interface Endpoint bật Private DNS
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false

# (Tùy chọn) AWS Credentials tĩnh - Khuyên để trống khi chạy trên EC2 đã gắn IAM Role (Instance Profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
