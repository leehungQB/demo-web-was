# Cổng chạy ứng dụng Web (Mặc định: 3000 hoặc 80)
PORT=3000

# URL máy chủ WAS Backend API để Web Server làm Reverse Proxy
# Cách 1: Trỏ trực tiếp tới IP Private của EC2 WAS:
WAS_API_URL=http://10.0.27.74:5000

# Cách 2: Trỏ tới DNS Name của Internal Load Balancer (Internal ALB / NLB) đứng trước cụm WAS:
# WAS_API_URL=http://internal-was-alb-123456789.ap-southeast-1.elb.amazonaws.com:5000
# (Hoặc không cần :5000 nếu Listener của Internal ALB lắng nghe ở cổng 80)

